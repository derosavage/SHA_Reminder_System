# sha-pay - Environment Variables
# Copy this to .env and fill in your values

# App
# DEBUG=true also returns the OTP in auth responses when SMS is not configured,
# so local testing works without Africa's Talking credentials. Never deploy with
# DEBUG=true.
DEBUG=true
SECRET_KEY=change-this-in-production-use-a-256-bit-key-here

# Escape hatch for a throwaway instance only: lets the API start without a
# SECRET_KEY and skips the startup SECRET_KEY checks. It does NOT expose OTPs
# (that is DEBUG's job). Leave false unless you are running a local demo.
ALLOW_INSECURE_DEFAULTS=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://shapay_user:shapay_pass@localhost:5432/shapay_db
DATABASE_URL_SYNC=postgresql://shapay_user:shapay_pass@localhost:5432/shapay_db

# Redis (for Celery & caching)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# M-Pesa Daraja API (sandbox)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_PASSKEY=your_passkey_here
MPESA_BUSINESS_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/payments/callback
# Shared secret echoed back as ?token=... on the callback URL. Generate with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Callbacks are
# rejected (403) when this is unset.
MPESA_CALLBACK_SECRET=

# Africa's Talking SMS (sandbox)
AT_API_KEY=your_at_api_key_here
AT_USERNAME=sandbox
AT_SENDER_ID=SHAPAY

# Supabase (optional - for auth/hosting)
SUPABASE_URL=
SUPABASE_KEY=

# SHA Official
SHA_MINIMUM_CONTRIBUTION=300
SHA_PAYMENT_DEADLINE_DAY=9
SHA_LATE_PENALTY_RATE=0.02
SHA_MAX_PENALTY_MONTHS=12