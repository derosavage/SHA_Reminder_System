{
    "bot_name": "Danvas1",
    "version": "1.0.0",
    "created_date": "2024-01-15",

    "trading": {
        "default_symbol": "BTCUSDT",
        "scan_symbols": ["BTCUSDT", "ETHUSDT", "SOLUSDT"],
        "max_concurrent_trades": 3,
        "default_leverage": 5,
        "max_leverage": 10
    },

    "risk_management": {
        "risk_percent": 0.20,
        "max_daily_drawdown": 0.05,
        "max_consecutive_losses": 3,
        "trade_cooldown_minutes": 30,
        "min_risk_reward_ratio": 2.0,
        "max_margin_usage_percent": 0.50
    },

    "strategy": {
        "rsi_period": 14,
        "rsi_oversold": 30,
        "rsi_overbought": 70,
        "htf_timeframes": ["1H", "4H", "12H", "D"],
        "ltf_timeframe": "15m",
        "atr_period": 14,
        "atr_multiplier_sl": 2.5,
        "atr_multiplier_tp": 4.0,
        "min_confluence_score": 3
    },

    "execution": {
        "order_type": "Market",
        "fill_timeout_seconds": 30,
        "max_slippage_percent": 0.3,
        "enable_partial_tp": true,
        "tp_levels": [
            {"percent": 50, "close_pct": 0.33},
            {"percent": 30, "close_pct": 0.33},
            {"percent": 20, "close_pct": 0.34}
        ]
    },

    "safety": {
        "max_api_retries": 3,
        "retry_delay_seconds": 5,
        "enable_watchdog": true,
        "watchdog_interval_seconds": 60,
        "auto_reconnect": true,
        "healthcheck_interval_seconds": 300
    },

    "logging": {
        "log_level": "INFO",
        "log_rotation_size_mb": 100,
        "log_backup_count": 5,
        "save_trades_csv": true,
        "save_performance_excel": true
    },

    "backtesting": {
        "default_start_date": "2024-01-01",
        "default_end_date": "2024-12-31",
        "initial_capital": 10000,
        "fee_rate": 0.00055,
        "slippage_percent": 0.1
    }
}