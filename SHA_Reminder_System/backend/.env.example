# SHA Reminder System - Environment Variables
# Copy this to .env and fill in your values

# App
DEBUG=true
SECRET_KEY=change-this-in-production-use-a-256-bit-key-here

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://sha_user:sha_pass@localhost:5432/sha_db
DATABASE_URL_SYNC=postgresql://sha_user:sha_pass@localhost:5432/sha_db

# Redis (for Celery & caching)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# M-Pesa Daraja API (sandbox)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_PASSKEY=your_passkey_here
MPESA_BUSINESS_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/payments/callback
# Shared secret Safaricom's callback must echo back (as ?token=...) so
# /payments/callback can reject forged "payment succeeded" requests.
# Required when ALLOW_INSECURE_DEFAULTS=false.
MPESA_CALLBACK_TOKEN=generate-a-long-random-value-here

# Africa's Talking SMS (sandbox)
AT_API_KEY=your_at_api_key_here
AT_USERNAME=sandbox
AT_SENDER_ID=SHA_RMD

# Supabase (optional - for auth/hosting)
SUPABASE_URL=
SUPABASE_KEY=

# SHA Official
SHA_MINIMUM_CONTRIBUTION=300
SHA_PAYMENT_DEADLINE_DAY=9
SHA_LATE_PENALTY_RATE=0.02
SHA_MAX_PENALTY_MONTHS=12